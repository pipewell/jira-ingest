# ── Mode ────────────────────────────────────────────────────────────────────
# "cloud" (Jira Cloud, Basic Auth) or "dc" (Jira Data Center, Bearer + mTLS)
JIRA_MODE=cloud

# ── Connection ───────────────────────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=your_api_token_here

# Cloud only
JIRA_EMAIL=your.name@example.com

# DC only: base64-encoded PEM (private key + cert + CA chain)
# JIRA_CERT_PEM=<base64-encoded-pem>

# ── Scope ────────────────────────────────────────────────────────────────────
# Comma-separated project keys to filter (leave empty to fetch all)
JIRA_PROJECT_KEYS=PROJ,INFRA

# ── Custom fields ────────────────────────────────────────────────────────────
# JSON map of logical_name -> Jira field ID
# These will be extracted from every issue and included in output
# JIRA_CUSTOM_FIELDS={"type_of_work": "customfield_10100", "team": "customfield_10001"}

# ── Output ───────────────────────────────────────────────────────────────────
# Format: csv | parquet | jsonl
JIRA_OUTPUT_FORMAT=parquet

# Sink URI — where output files are written
# Local filesystem:
JIRA_SINK_URI=./output
# S3:
# JIRA_SINK_URI=s3://your-bucket/jira-ingest
# Azure Blob Storage:
# JIRA_SINK_URI=az://your-container/jira-ingest
# Google Cloud Storage:
# JIRA_SINK_URI=gs://your-bucket/jira-ingest

# Storage options as JSON (auth credentials for the chosen sink)
# S3 with IAM role (no explicit credentials needed):
# JIRA_SINK_OPTIONS={}
# S3 with explicit credentials:
# JIRA_SINK_OPTIONS={"key": "AKIAIOSFODNN7", "secret": "wJalrXUtnFEMI"}
# Azure with account key:
# JIRA_SINK_OPTIONS={"account_name": "mystorageaccount", "account_key": "..."}

# ── Redshift (optional) ──────────────────────────────────────────────────────
# REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
# REDSHIFT_PORT=5439
# REDSHIFT_DATABASE=analytics
# REDSHIFT_USER=jira_loader
# REDSHIFT_PASSWORD=your_password
# REDSHIFT_SCHEMA=bronze
# REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/RedshiftS3ReadRole

# ── Tuning ───────────────────────────────────────────────────────────────────
JIRA_MAX_CONCURRENT_REQUESTS=10
JIRA_REQUEST_TIMEOUT_SECONDS=120
JIRA_CACHE_TTL_SECONDS=300
JIRA_MAX_RETRY_ATTEMPTS=20

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
